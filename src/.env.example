# Tortuga SOC — environment template
# Copy this to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored; never commit real secrets.

# --- Database ---
# MongoDB connection string (mongodb+srv://user:pass@host/db?...).
# NOTE: server/index.ts currently HARDCODES this connection string.
# Refactor it to `useRuntimeConfig().dbURI` so this value is actually used.
DB_URI=

# --- Auth ---
# bcrypt salt rounds (integer, e.g. 10). Parsed via parseInt().
SALT=10
# Secret used to sign/verify JWT auth tokens. Use a long random string.
JWT_KEY=

# --- Frontend ---
# Public base URL, used in password-reset email links (e.g. http://localhost:8000).
FRONTEND_URL=http://localhost:8000

# --- Cron / notification pipeline ---
# Shared secret required as `Authorization: Bearer <CRON_SECRET>` to trigger
# the slingshot cron endpoint (server/api/cron-jobs/slingshot.get.ts).
CRON_SECRET=
# Shared secret checked against the api-key header for the EventBridge-driven
# watchlist cron endpoint (server/api/cron-jobs/watchlist.get.ts).
EVENTBRIDGE_SECRET=

# --- Google Gemini (schedule generator) ---
# The @google/genai client (server/api/scraper/generate-schedule.get.ts) reads
# GEMINI_API_KEY (or GOOGLE_API_KEY) from the environment automatically.
GEMINI_API_KEY=

# --- Email (nodemailer / Gmail) ---
# server/config/send-email.ts currently HARDCODES the Gmail user + app password.
# Move them here and read from process.env, then rotate the exposed credentials.
EMAIL_USER=
EMAIL_APP_PASSWORD=

# --- SMS (AWS SNS) ---
# Used by server/config/send-sms.ts to send transactional SMS.
# The account must be out of the SNS SMS sandbox (or the destination number
# must be verified in the sandbox) to actually deliver texts.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Runtime ---
NODE_ENV=development
